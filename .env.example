# PostgreSQL
POSTGRES_DB=altspotify
POSTGRES_USER=altspotify
POSTGRES_PASSWORD=changeme

# Security
# Required, at least 32 random characters: openssl rand -hex 32
SECRET_KEY=

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=alt-spotify
MINIO_SECURE=false

# JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=changeme

# Spotify API (for playlist import)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Domain (for Traefik / production)
DOMAIN=localhost

# Redis
REDIS_URL=redis://redis:6379/0
