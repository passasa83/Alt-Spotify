# PostgreSQL
POSTGRES_DB=altspotify
POSTGRES_USER=altspotify
POSTGRES_PASSWORD=changeme

# Security
# Required, at least 32 random characters: openssl rand -hex 32
SECRET_KEY=

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=alt-spotify
MINIO_SECURE=false

# JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=changeme

# Spotify API (for playlist import)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# IP de publication des ports : backend 8000, frontend 3000, MinIO 9000/9001.
# 0.0.0.0 = toutes les interfaces → joignable via l'IP de la machine (défaut,
# comme la plupart des stacks Docker). Une IP fixe ici restreint l'exposition.
BIND_IP=0.0.0.0

# URL de base des liens générés par le backend (partage, invitations admin).
# Elle doit être atteignable depuis le navigateur du visiteur, donc :
#   http://192.168.1.10:3000     # accès direct via l'IP de la machine
#   https://app.exemple.com      # derrière un reverse proxy
BASE_URL=http://localhost:3000

# Inscription des comptes :
#  false = seul le PREMIER compte est créable librement (il devient admin),
#          ensuite inscription fermée → invitations admin uniquement ;
#  true  = inscription ouverte pour tout le monde.
OPEN_REGISTRATION=false

# Docker network shared with the external reverse proxy (Nginx Proxy Manager,
# Traefik, ...). On it the services are reachable as `backend:8000` and
# `frontend:80`. Two modes:
#  - PROXY_EXTERNAL=false (default): this stack CREATES the network, and the
#    proxy declares it `external: true` to join it (this stack must start first).
#  - PROXY_EXTERNAL=true: this stack JOINS a network already created by the
#    proxy (e.g. npm-network) — the proxy's compose stays untouched and boot
#    order doesn't matter. Create it first if needed:
#    docker network create npm-network
PROXY_NETWORK=altspotify-proxy
PROXY_EXTERNAL=false

# Origins allowed to call the API (comma separated).
# Only matters if the frontend and the API are served from DIFFERENT origins.
# Behind a single reverse proxy they share one origin, but if you use separate
# subdomains (app.example.com / api.example.com) list them here.
CORS_ORIGINS=*

# Redis
REDIS_URL=redis://redis:6379/0
